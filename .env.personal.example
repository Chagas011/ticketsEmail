# Exemplo sem credenciais reais. Acrescente estes valores ao arquivo .env existente.
GRAPH_CLIENT_ID=ID_DO_APLICATIVO
GRAPH_CLIENT_SECRET=VALOR_DO_SEGREDO_DO_APLICATIVO
GRAPH_PUBLIC_URL=https://SEU_DOMINIO_PUBLICO
GRAPH_CLIENT_STATE=VALOR_ALEATORIO_ENTRE_32_E_128_CARACTERES
GRAPH_CONNECT_SECRET=OUTRO_VALOR_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
# Somente para quem também utilizar a autenticação JWT anterior no SSE:
GRAPH_TENANT_ID=ID_DO_TENANT
AUTH_JWT_AUDIENCE=ID_DA_API
AUTH_JWT_REQUIRED_SCOPE=access_as_user
