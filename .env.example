GRAPH_CLIENT_ID=ID_DO_APLICATIVO
GRAPH_TENANT_ID=ID_DO_TENANT_CORPORATIVO
GRAPH_CLIENT_SECRET=VALOR_DO_SEGREDO_DO_APLICATIVO
# ID de objeto do usuário ou da mailbox compartilhada no Entra.
GRAPH_MAILBOX_USER_ID=ID_DO_OBJETO_DA_MAILBOX
# Necessário para identificar a caixa na resposta de conversas.
GRAPH_MAILBOX_ADDRESS=caixa@empresa.com
GRAPH_PUBLIC_URL=https://SEU_DOMINIO_PUBLICO
GRAPH_CLIENT_STATE=VALOR_ALEATORIO_ENTRE_32_E_128_CARACTERES
# Opcional: configure se o frontend estiver em outra origem.
FRONTEND_ORIGIN=http://localhost:5173
# Redis da fila de mensagens; use rediss:// para conexão TLS.
REDIS_URL=redis://localhost:6379/0
# Chave da API da OpenAI usada pelo worker para avaliar novos chamados.
OPENAI_API_KEY=SUA_CHAVE_DA_API_OPENAI
# Modelo usado na triagem de e-mails.
OPENAI_MODEL=gpt-6-luna
